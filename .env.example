# Qwen (OpenAI-совместимый API). Подписка Token Plan — ключ sk-sp-...
# Token Plan: https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
# PAYG Standard: https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# PAYG Workspace: https://ws-<id>.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=
QWEN_BASE_URL=https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.8-max

# Chutes — ключ можно оставить; не primary, пока квота пустая
CHUTES_API_TOKEN=
CHUTES_BASE_URL=https://llm.chutes.ai/v1
CHUTES_MODEL=zai-org/GLM-5.1-TEE

# auto | qwen | chutes  (auto зовёт Chutes только при PAGE_SUMMARIZER_CHUTES_ENABLED=true)
PAGE_SUMMARIZER_PROVIDER=qwen
PAGE_SUMMARIZER_CHUTES_ENABLED=false
PAGE_SUMMARIZER_HTTP_TIMEOUT=20
PAGE_SUMMARIZER_LLM_TIMEOUT=90
PAGE_SUMMARIZER_MAX_RETRIES=3
PAGE_SUMMARIZER_MAX_INPUT_CHARS=12000
PAGE_SUMMARIZER_USER_AGENT=Mozilla/5.0 (compatible; JudicialActAnalyzer/1.0; educational project)
PAGE_SUMMARIZER_LOG_LEVEL=DEBUG
PAGE_SUMMARIZER_LOG_FILE=page_summarizer.log
